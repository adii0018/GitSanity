{
  "name": "gitsanity",
  "displayName": "GitSanity",
  "description": "Scan, secure and commit safely",
  "version": "0.1.0",
  "preview": true,
  "publisher": "your-publisher-id",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "secrets",
    "git",
    "commit",
    "pre-commit",
    "security",
    "env",
    "linter",
    "console.log",
    "credentials"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1B2B",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-username>/gitsanity"
  },
  "bugs": {
    "url": "https://github.com/<your-username>/gitsanity/issues"
  },
  "homepage": "https://github.com/<your-username>/gitsanity#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Git repository operations, pre-commit hook management, and GitHub publishing are disabled in untrusted workspaces. In-editor scanning remains active."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitsanity.menu",
        "title": "GitSanity: Show Menu",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.showDashboard",
        "title": "GitSanity: Show Dashboard",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.reviewBeforeCommit",
        "title": "GitSanity: Review Before Commit",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.safeCommit",
        "title": "GitSanity: Safe Commit",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.undoLastCommit",
        "title": "GitSanity: Undo Last Commit",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.scanProject",
        "title": "GitSanity: Scan Project",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.clearProjectScan",
        "title": "GitSanity: Clear Project Scan Issues",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.showHealthReport",
        "title": "GitSanity: Show Health Report",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.scanHistory",
        "title": "GitSanity: Scan Git History",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.findOldTodos",
        "title": "GitSanity: Find Old TODOs",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.createRepository",
        "title": "GitSanity: Create Repository",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.publishToGitHub",
        "title": "GitSanity: Publish to GitHub",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.installHook",
        "title": "GitSanity: Install Git Hook",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.uninstallHook",
        "title": "GitSanity: Uninstall Git Hook",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.createConfig",
        "title": "GitSanity: Create Config File",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.rescanOpenFiles",
        "title": "GitSanity: Rescan Open Files",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.moveSecretToEnv",
        "title": "GitSanity: Move Secret to .env",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.moveAllSecretsInFile",
        "title": "GitSanity: Move All Secrets in This File to .env",
        "category": "GitSanity"
      },
      {
        "command": "gitsanity.addEnvToGitignore",
        "title": "GitSanity: Add .env to .gitignore",
        "category": "GitSanity"
      }
    ],
    "configuration": {
      "title": "GitSanity",
      "properties": {
        "gitsanity.promptOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Show suggestion prompt when opening a folder without Git or offering a whole-project scan."
        },
        "gitsanity.warnOnMainBranch": {
          "type": "boolean",
          "default": true,
          "description": "Warn when attempting to commit directly to main or master branches."
        },
        "gitsanity.historyMaxCommits": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of commits to inspect during git history scan."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".gitsanity.json",
        "url": "./schemas/gitsanity.schema.json"
      }
    ]
  },
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node16 --external:vscode --outfile=out/extension.js --minify --sourcemap",
    "build:hook": "esbuild src/hook/preCommit.ts --bundle --platform=node --target=node16 --outfile=out/hook/pre-commit.bundle.js",
    "compile": "npm run check && npm run bundle && npm run build:hook",
    "watch": "esbuild src/extension.ts --bundle --platform=node --target=node16 --external:vscode --outfile=out/extension.js --sourcemap --watch",
    "test": "npm run build:hook && tsc -p tsconfig.test.json && node scripts/runTests.js",
    "vscode:prepublish": "npm run check && npm run bundle && npm run build:hook"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  }
}
